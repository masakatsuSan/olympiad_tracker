{
  "name": "olympiad-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/src/index.js\" \"npm --prefix client run dev\"",
    "start": "node server/src/index.js",
    "build": "npm --prefix client install && npm --prefix client run build",
    "seed": "node server/src/seed/seed.js",
    "test": "node --test \"server/test/*.test.js\"",
    "vercel-build": "npm --prefix client install && npm --prefix client run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.0.0",
    "concurrently": "^9.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}